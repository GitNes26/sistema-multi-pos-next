// FASE 1.1 — Schema Prisma completo (48 tablas) para MySQL 8.x
// Basado en el PLAN (sección 5). Prisma 6 + MySQL.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────────────────────────────────────────
// ENUMS
// ─────────────────────────────────────────────────────────────────────────────

enum OrgRole {
  owner
  manager
  cashier
  customer
  superadmin
  admin
}

enum MovementType {
  purchase
  sale
  adjustment
  transfer_in
  transfer_out
  return
}

enum PaymentMethod {
  cash
  card
  wallet
  other
  points
  credit
}

enum SaleStatus {
  open
  completed
  voided
}

enum ReturnType {
  exchange
  refund
  coupon
  points
}

enum ReturnStatus {
  pending
  approved
  completed
  rejected
}

enum CashSessionStatus {
  open
  closed
}

enum PromoBenefit {
  percent_off
  amount_off
  fixed_price
  buy_x_get_y
  free_item
  next_purchase_coupon
}

enum PromoScope {
  order
  category
  product
  variant
}

enum OrderStatus {
  pending
  confirmed
  preparing
  ready
  in_transit
  at_destination
  delivered
  cancelled
}

enum LoyaltyKind {
  earn
  redeem
  adjust
  expire
}

enum DeliveryMethod {
  pickup
  delivery
}

enum RevisionStatus {
  draft
  in_progress
  completed
  cancelled
}

enum ProductType {
  standard
  bulk
}

enum LocationType {
  location
  cedis
}

enum PromotionTargetKind {
  location
  category
  product
  variant
  reward_variant
}

enum PublicationType {
  product_new
  promotion
  notice
}

enum BusinessMode {
  retail        // Tienda, abarrotes, ferretería, snacks
  food_service  // Neverías, restaurante, café, cafeteria
  services      // Barbería, autolavado, veterinaria
  rental        // Brincolines, fotografía, maquinaria
  hybrid        // Combinación de los anteriores
}

enum TableStatus {
  free
  occupied
  reserved
  cleaning
}

enum OrderItemStatus {
  pending
  preparing
  ready
  served
}

// ─────────────────────────────────────────────────────────────────────────────
// ORGANIZACIÓN Y USUARIOS
// ─────────────────────────────────────────────────────────────────────────────

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  passwordHash  String
  fullName      String
  avatarUrl     String?
  phone         String?
  isActive      Boolean   @default(true)
  emailVerified DateTime?
  // 7.9 — Flag de rol superAdmin (identificación por rol, no por email)
  isSuperadmin  Boolean   @default(false)
  // FASE 2.5 — Recuperación de contraseña (token guardado hasheado)
  passwordResetToken   String?   @unique
  passwordResetExpires DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  memberships                    Membership[]
  profile                        Profile?
  organizationsOwned             Organization[]               @relation("OrganizationOwner")
  employees                      Employee[]
  customers                      Customer[]
  cashSessionsUser               CashSession[]                @relation("CashSessionUser")
  cashSessionsOpened             CashSession[]                @relation("CashSessionOpenedBy")
   salesCashier                   Sale[]                       @relation("SaleCashier")
   saleReturnsProcessed           SaleReturn[]
   inventoryMovements             InventoryMovement[]
  variantPriceHistory            VariantPriceHistory[]
  inventoryRevisionsPerformed    InventoryRevision[]          @relation("InventoryRevisionPerformedBy")
  inventoryRevisionItemsCounted  InventoryRevisionItem[]      @relation("InventoryRevisionItemCountedBy")
  promotionsCreated              Promotion[]                  @relation("PromotionCreatedBy")
  orderStatusHistory             OrderStatusHistory[]
  notifications                  Notification[]
  invitationsSent                UserInvitation[]             @relation("UserInvitationInvitedBy")
  pushSubscriptions              PushSubscription[]

  @@map("users")
}

model Organization {
  id                 String   @id @default(cuid())
  name               String
  ownerId            String
  businessMode       BusinessMode @default(retail)
  currency           String   @default("MXN")
  pointsPerCurrency  Decimal  @default(1) @db.Decimal(12, 4)
  pointValue         Decimal  @default(1) @db.Decimal(12, 4)
  loyaltyEnabled     Boolean  @default(true)
  supervisorApproval Json     @default("{}")
  paymentGateway     Json     @default("{}")
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  owner                 User                  @relation("OrganizationOwner", fields: [ownerId], references: [id])
  memberships           Membership[]
  companyProfile        CompanyProfile?
  appSettings           AppSettings?
  employeePositions     EmployeePosition[]
  employees             Employee[]
  customers             Customer[]
  customerPaymentMethods CustomerPaymentMethod[]
  customerFavorites     CustomerFavorite[]
  shoppingLists         ShoppingList[]
  locations             Location[]
  cedis                 Cedi[]
  cashRegisters         CashRegister[]
  cashSessions          CashSession[]
  categories            Category[]
  unitsOfMeasure        UnitOfMeasure[]
  products              Product[]
  productVariants       ProductVariant[]
  inventory             Inventory[]
  inventoryMovements    InventoryMovement[]
  variantPriceHistory   VariantPriceHistory[]
  inventoryRevisions    InventoryRevision[]
   sales                 Sale[]
   saleReturns           SaleReturn[]
   promotions            Promotion[]
  coupons               Coupon[]
  loyaltyTransactions   LoyaltyTransaction[]
  orders                Order[]
  tables                Table[]
  roles                 Role[]
  rolePermissions       RolePermission[]
  userInvitations       UserInvitation[]
  notifications         Notification[]
  publications          Publication[]
  deliveryPolicy        DeliveryPolicy?
  creditPolicy          CreditPolicy?
  customerCredits       CustomerCredit[]
  creditTransactions    CreditTransaction[]
  productCombos         ProductCombo[]
  customerAddresses     CustomerAddress[]
  pushSubscriptions     PushSubscription[]
  dailySalesSummaries   DailySalesSummary[]
  hourlySnapshots       HourlySalesSnapshot[]
  productPairs          ProductPair[]
  inventorySnapshots    InventorySnapshot[]
  transfers             Transfer[]
  employeeCommissions   EmployeeCommission[]
  customerSegments      CustomerSegment[]

  @@map("organizations")
}

model Membership {
  id             String   @id @default(cuid())
  userId         String
  organizationId String
  role           OrgRole
  roleId         String?
  createdAt      DateTime @default(now())

  user         User         @relation(fields: [userId], references: [id])
  organization Organization @relation(fields: [organizationId], references: [id])
  roleRef      Role?        @relation(fields: [roleId], references: [id])

  @@unique([userId, organizationId])
  @@map("memberships")
}

// 1:1 con users (mismo id)
model Profile {
  id          String   @id
  user        User     @relation(fields: [id], references: [id])
  fullName    String?
  avatarUrl   String?
  phone       String?
  preferences Json     @default("{}")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("profiles")
}

model CompanyProfile {
  id             String   @id @default(cuid())
  organizationId String   @unique
  legalName      String?
  tradeName      String?
  taxId          String?
  logoUrl        String?
  address        String?
  city           String?
  state          String?
  postalCode     String?
  country        String?
  phone          String?
  email          String?
  website        String?
  ticketFooter   String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id])

  @@map("company_profiles")
}

model DeliveryPolicy {
  id             String   @id @default(cuid())
  organizationId String   @unique

  // Pickup settings
  pickupEnabled       Boolean  @default(true)
  pickupMinAmount     Decimal? @db.Decimal(12, 2)
  pickupFee           Decimal? @default(0) @db.Decimal(12, 2)
  pickupFeeEnabled    Boolean  @default(false)
  pickupScheduleJson  String?  @db.Text

  // Delivery settings
  deliveryEnabled       Boolean  @default(false)
  deliveryMinAmount     Decimal? @db.Decimal(12, 2)
  deliveryFee           Decimal? @default(0) @db.Decimal(12, 2)
  deliveryFeeEnabled    Boolean  @default(false)
  deliveryScheduleJson  String?  @db.Text
  deliveryRadiusKm      Decimal? @db.Decimal(5, 2)
  deliveryEstimatedMins Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id])

  @@map("delivery_policies")
}

model BranchDeliveryPolicy {
  id             String   @id @default(cuid())
  branchId       String   @unique

  // Pickup settings
  pickupEnabled       Boolean  @default(true)
  pickupMinAmount     Decimal? @db.Decimal(12, 2)
  pickupFee           Decimal? @default(0) @db.Decimal(12, 2)
  pickupFeeEnabled    Boolean  @default(false)
  pickupScheduleJson  String?  @db.Text

  // Delivery settings
  deliveryEnabled       Boolean  @default(false)
  deliveryMinAmount     Decimal? @db.Decimal(12, 2)
  deliveryFee           Decimal? @default(0) @db.Decimal(12, 2)
  deliveryFeeEnabled    Boolean  @default(false)
  deliveryScheduleJson  String?  @db.Text
  deliveryRadiusKm      Decimal? @db.Decimal(5, 2)
  deliveryEstimatedMins Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  branch Location @relation(fields: [branchId], references: [id])

  @@map("branch_delivery_policies")
}

// ─────────────────────────────────────────────────────────────────────────────
// CRÉDITO / CUENTAS POR COBRAR
// ─────────────────────────────────────────────────────────────────────────────

model CreditPolicy {
  id                    String   @id @default(cuid())
  organizationId        String   @unique
  creditEnabled         Boolean  @default(false)
  defaultLimit          Decimal? @db.Decimal(12, 2)
  maxDaysToPay          Int      @default(30)
  requireApproval       Boolean  @default(true)
  allowPartialPayments  Boolean  @default(true)
  interestRate          Decimal? @db.Decimal(5, 4)
  notifyBeforeDays      Int      @default(3)

  organization Organization @relation(fields: [organizationId], references: [id])

  @@map("credit_policies")
}

model CustomerCredit {
  id             String   @id @default(cuid())
  customerId     String   @unique
  organizationId String
  creditLimit    Decimal? @db.Decimal(12, 2)
  currentBalance Decimal  @default(0) @db.Decimal(12, 2)
  status         String   @default("active")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id])
  customer     Customer     @relation(fields: [customerId], references: [id])
  transactions CreditTransaction[]

  @@map("customer_credits")
}

model CreditTransaction {
  id             String   @id @default(cuid())
  creditId       String
  customerId     String
  organizationId String
  type           String
  amount         Decimal  @db.Decimal(12, 2)
  balanceAfter   Decimal  @db.Decimal(12, 2)
  description    String?
  referenceType  String?
  referenceId    String?
  dueDate        DateTime?
  paidAt         DateTime?
  createdAt      DateTime @default(now())

  credit       CustomerCredit @relation(fields: [creditId], references: [id])
  customer     Customer       @relation(fields: [customerId], references: [id])
  organization Organization   @relation(fields: [organizationId], references: [id])

  @@map("credit_transactions")
}

model AppSettings {
  id             String   @id @default(cuid())
  organizationId String   @unique
  primaryHue     Int      @default(210)
  accentHue      Int      @default(150)
  theme          String   @default("system")
  fontFamily     String   @default("montserrat")
  fontScale      Decimal  @default(1) @db.Decimal(3, 2)
  cardSize       String   @default("md")
  density        String   @default("comfortable")
  borderRadius   Decimal  @default(0.75) @db.Decimal(3, 2)
  sidebarStyle   String   @default("full")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id])

  @@map("app_settings")
}

// ─────────────────────────────────────────────────────────────────────────────
// EMPLEADOS Y CLIENTES
// ─────────────────────────────────────────────────────────────────────────────

model EmployeePosition {
  id             String   @id @default(cuid())
  organizationId String
  name           String
  description    String?
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id])
  employees    Employee[]

  @@map("employee_positions")
}

model Employee {
  id             String   @id @default(cuid())
  organizationId String
  userId         String
  positionId     String?
  locationId     String?
  employeeCode   String?
  fullName       String
  phone          String?
  imageUrl       String?
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization        Organization           @relation(fields: [organizationId], references: [id])
  user                User                   @relation(fields: [userId], references: [id])
  position            EmployeePosition?      @relation(fields: [positionId], references: [id])
  location            Location?              @relation(fields: [locationId], references: [id])
  cashSessions        CashSession[]
   sales               Sale[]
   saleReturns         SaleReturn[]
   inventoryMovements  InventoryMovement[]
  inventoryRevisions  InventoryRevision[]
  orderStatusHistory  OrderStatusHistory[]
  orderPreparation    OrderPreparation[]
  notifications       Notification[]
  commissions         EmployeeCommission[]

  @@unique([organizationId, employeeCode])
  @@unique([organizationId, userId])
  @@map("employees")
}

model Customer {
  id             String   @id @default(cuid())
  organizationId String
  userId         String
  customerCode   String?
  fullName       String
  phone          String?
  email          String?
  points         Decimal  @default(0) @db.Decimal(12, 2)
  imageUrl       String?
  address        String?
  latitude       Decimal? @db.Decimal(10, 8)
  longitude      Decimal? @db.Decimal(11, 8)
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization          Organization            @relation(fields: [organizationId], references: [id])
  user                  User                    @relation(fields: [userId], references: [id])
  paymentMethods        CustomerPaymentMethod[]
  favorites             CustomerFavorite[]
  shoppingLists         ShoppingList[]
  sales                 Sale[]
  coupons               Coupon[]
  loyaltyTransactions   LoyaltyTransaction[]
  orders                Order[]
  addresses             CustomerAddress[]
  creditAccount         CustomerCredit?
  creditTransactions    CreditTransaction[]
  segments              CustomerSegment[]

  @@unique([organizationId, customerCode])
  @@unique([organizationId, userId])
  // Teléfono único por org: en MySQL, UNIQUE permite múltiples NULL,
  // replicando el partial index del plan (UNIQUE WHERE phone IS NOT NULL)
  @@unique([organizationId, phone])
  @@map("customers")
}

model CustomerPaymentMethod {
  id                     String   @id @default(cuid())
  customerId             String
  organizationId         String
  alias                  String?
  brand                  String?
  last4                  String?
  expMonth               Int?
  expYear                Int?
  isDefault              Boolean  @default(false)
  color                  String?
  stripePaymentMethodId  String?
  createdAt              DateTime @default(now())

  customer     Customer     @relation(fields: [customerId], references: [id])
  organization Organization @relation(fields: [organizationId], references: [id])

  @@map("customer_payment_methods")
}

model CustomerAddress {
  id             String   @id @default(cuid())
  organizationId String
  customerId     String
  label          String
  address        String
  latitude       Decimal? @db.Decimal(10, 8)
  longitude      Decimal? @db.Decimal(11, 8)
  notes          String?
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id])
  customer     Customer     @relation(fields: [customerId], references: [id])

  @@map("customer_addresses")
}

model CustomerFavorite {
  id             String   @id @default(cuid())
  organizationId String
  customerId     String
  variantId      String
  createdAt      DateTime @default(now())

  organization Organization  @relation(fields: [organizationId], references: [id])
  customer     Customer      @relation(fields: [customerId], references: [id])
  variant      ProductVariant @relation(fields: [variantId], references: [id])

  @@unique([customerId, variantId])
  @@map("customer_favorites")
}

model ShoppingList {
  id             String   @id @default(cuid())
  organizationId String
  customerId     String
  name           String
  notes          String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization         @relation(fields: [organizationId], references: [id])
  customer     Customer             @relation(fields: [customerId], references: [id])
  items        ShoppingListItem[]

  @@map("shopping_lists")
}

model ShoppingListItem {
  id        String   @id @default(cuid())
  listId    String
  variantId String
  quantity  Decimal  @default(1) @db.Decimal(12, 3)
  createdAt DateTime @default(now())

  list    ShoppingList    @relation(fields: [listId], references: [id])
  variant ProductVariant  @relation(fields: [variantId], references: [id])

  @@map("shopping_list_items")
}

// ─────────────────────────────────────────────────────────────────────────────
// SUCURSALES, CEDIS Y CAJAS
// ─────────────────────────────────────────────────────────────────────────────

model Location {
  id             String   @id @default(cuid())
  organizationId String
  name           String
  code           String?
  address        String?
  latitude       Decimal? @db.Decimal(10, 8)
  longitude      Decimal? @db.Decimal(11, 8)
  managerName    String?
  phone          String?
  email          String?
  openingHours        String?
  openingScheduleJson String?   @db.Text
  imageUrl            String?
  notes               String?
  timezone            String   @default("America/Mexico_City")
  allowsPickup        Boolean  @default(true)
  allowsDelivery      Boolean  @default(false)
  saleSeq        BigInt   @default(0)
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())

  organization    Organization          @relation(fields: [organizationId], references: [id])
  cashRegisters   CashRegister[]
  cashSessions    CashSession[]
  sales           Sale[]
  orders          Order[]
  employees       Employee[]
  notifications   Notification[]
  tables          Table[]
  branchDeliveryPolicy BranchDeliveryPolicy?
  dailySalesSummaries   DailySalesSummary[]
  hourlySnapshots       HourlySalesSnapshot[]
  inventorySnapshots    InventorySnapshot[]
  transfersFrom         Transfer[] @relation("TransferFrom")
  transfersTo           Transfer[] @relation("TransferTo")

  @@map("locations")
}

model Cedi {
  id             String   @id @default(cuid())
  organizationId String
  name           String
  code           String?
  address        String?
  latitude       Decimal? @db.Decimal(10, 8)
  longitude      Decimal? @db.Decimal(11, 8)
  managerName    String?
  phone          String?
  email          String?
  openingHours        String?
  openingScheduleJson String?   @db.Text
  imageUrl            String?
  notes               String?
  timezone            String   @default("America/Mexico_City")
  isActive            Boolean  @default(true)
  createdAt           DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id])

  @@map("cedis")
}

model CashRegister {
  id             String   @id @default(cuid())
  locationId     String
  organizationId String
  name           String
  folioPrefix    String?
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())

  location     Location       @relation(fields: [locationId], references: [id])
  organization Organization   @relation(fields: [organizationId], references: [id])
  cashSessions CashSession[]
  sales        Sale[]

  @@map("cash_registers")
}

model CashSession {
  id             String            @id @default(cuid())
  organizationId String
  locationId     String
  cashRegisterId String
  employeeId     String?
  userId         String?
  openedBy       String?
  openingCash    Decimal           @default(0) @db.Decimal(12, 2)
  closingCash    Decimal?          @db.Decimal(12, 2)
  closedAt       DateTime?
  notes          String?
  status         CashSessionStatus @default(open)
  openedAt       DateTime          @default(now())

  organization Organization @relation(fields: [organizationId], references: [id])
  location     Location     @relation(fields: [locationId], references: [id])
  cashRegister CashRegister @relation(fields: [cashRegisterId], references: [id])
  employee     Employee?    @relation(fields: [employeeId], references: [id])
  user         User?        @relation("CashSessionUser", fields: [userId], references: [id])
  openedByUser User?        @relation("CashSessionOpenedBy", fields: [openedBy], references: [id])
   sales        Sale[]
   saleReturns  SaleReturn[]

   @@map("cash_sessions")
}

// ─────────────────────────────────────────────────────────────────────────────
// CATÁLOGOS
// ─────────────────────────────────────────────────────────────────────────────

model Category {
  id             String   @id @default(cuid())
  organizationId String
  parentId       String?
  name           String
  imageUrl       String?
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id])
  parent       Category?    @relation("CategoryHierarchy", fields: [parentId], references: [id])
  children     Category[]   @relation("CategoryHierarchy")
  products     Product[]

  @@map("categories")
}

model UnitOfMeasure {
  id               String   @id @default(cuid())
  organizationId   String?
  name             String
  abbreviation     String
  type             String
  baseUnit         String?
  conversionFactor Decimal  @default(1) @db.Decimal(12, 6)
  isActive         Boolean  @default(true)
  createdAt        DateTime @default(now())

  organization      Organization?       @relation(fields: [organizationId], references: [id])
  bulkProducts      Product[]           @relation("BulkUnit")
  splitProducts     Product[]           @relation("SplitUnit")
  inventory         Inventory[]
  inventoryMovements InventoryMovement[]
  saleItems         SaleItem[]
  orderItems        OrderItem[]

  @@unique([organizationId, abbreviation])
  @@map("units_of_measure")
}

model Product {
  id                String      @id @default(cuid())
  organizationId    String
  categoryId        String?
  name              String
  description       String?
  imageUrl          String?
  taxRate           Decimal     @default(0) @db.Decimal(5, 4)
  isActive          Boolean     @default(true)
  trackInventory    Boolean     @default(true)
  productType       ProductType @default(standard)
  bulkUnitId        String?
  bulkPricePerUnit  Decimal     @default(0) @db.Decimal(12, 2)
  bulkMinQuantity   Decimal     @default(0) @db.Decimal(12, 3)
  bulkStep          Decimal     @default(0.01) @db.Decimal(12, 3)
  bulkMaxQuantity   Decimal     @default(0) @db.Decimal(12, 3)
  allowSplit        Boolean     @default(false)
  splitUnitId       String?
  splitPricePerUnit Decimal     @default(0) @db.Decimal(12, 2)
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt

  organization      Organization       @relation(fields: [organizationId], references: [id])
  category          Category?          @relation(fields: [categoryId], references: [id])
  bulkUnit          UnitOfMeasure?     @relation("BulkUnit", fields: [bulkUnitId], references: [id])
  splitUnit         UnitOfMeasure?     @relation("SplitUnit", fields: [splitUnitId], references: [id])
  options           ProductOption[]
  variants          ProductVariant[]
  inventory         Inventory[]
  inventoryMovements InventoryMovement[]
  inventoryRevisionItems InventoryRevisionItem[]
  saleItems         SaleItem[]
  orderItems        OrderItem[]
  comboItems        ComboItem[]
  pairsA            ProductPair[] @relation("PairA")
  pairsB            ProductPair[] @relation("PairB")
  inventorySnapshots InventorySnapshot[]
  transferItems     TransferItem[]

  @@map("products")
}

model ProductOption {
  id        String  @id @default(cuid())
  productId String
  name      String
  position  Int     @default(0)
  required  Boolean @default(true)
  minSelect Int     @default(1)
  maxSelect Int     @default(1)

  product Product               @relation(fields: [productId], references: [id])
  values  ProductOptionValue[]

  @@map("product_options")
}

model ProductOptionValue {
  id         String   @id @default(cuid())
  optionId   String
  value      String
  extraPrice Decimal  @default(0) @db.Decimal(12, 2)
  imageUrl   String?
  isActive   Boolean  @default(true)
  position   Int      @default(0)

  option    ProductOption           @relation(fields: [optionId], references: [id])
  variants  VariantOptionValue[]

  @@map("product_option_values")
}

model ProductVariant {
  id             String   @id @default(cuid())
  productId      String
  organizationId String
  sku            String?
  barcode        String?
  name           String   @default("Default")
  price          Decimal  @default(0) @db.Decimal(12, 2)
  cost           Decimal  @default(0) @db.Decimal(12, 2)
  imageUrl       String?
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())

  product                  Product                  @relation(fields: [productId], references: [id])
  organization             Organization             @relation(fields: [organizationId], references: [id])
  optionValues             VariantOptionValue[]
  inventory                Inventory[]
  inventoryMovements       InventoryMovement[]
  variantPriceHistory      VariantPriceHistory[]
  saleItems                SaleItem[]
  orderItems               OrderItem[]
  customerFavorites        CustomerFavorite[]
  shoppingListItems        ShoppingListItem[]
  inventoryRevisionItems   InventoryRevisionItem[]
  comboItems               ComboItem[]

  @@index([barcode])
  @@map("product_variants")
}

model VariantOptionValue {
  variantId      String
  optionValueId  String

  variant     ProductVariant     @relation(fields: [variantId], references: [id])
  optionValue ProductOptionValue @relation(fields: [optionValueId], references: [id])

  @@id([variantId, optionValueId])
  @@map("variant_option_values")
}

// ─────────────────────────────────────────────────────────────────────────────
// COMBOS
// ─────────────────────────────────────────────────────────────────────────────

model ProductCombo {
  id             String   @id @default(cuid())
  organizationId String
  name           String
  description    String?
  imageUrl       String?
  comboPrice     Decimal  @db.Decimal(12, 2)
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization  @relation(fields: [organizationId], references: [id])
  items        ComboItem[]

  @@map("product_combos")
}

model ComboItem {
  id        String  @id @default(cuid())
  comboId   String
  productId String
  variantId String?
  quantity  Decimal @default(1) @db.Decimal(12, 3)
  extraPrice Decimal @default(0) @db.Decimal(12, 2)
  position  Int     @default(0)

  combo   ProductCombo    @relation(fields: [comboId], references: [id])
  product Product         @relation(fields: [productId], references: [id])
  variant ProductVariant? @relation(fields: [variantId], references: [id])

  @@map("combo_items")
}

// ─────────────────────────────────────────────────────────────────────────────
// INVENTARIO
// ─────────────────────────────────────────────────────────────────────────────

model Inventory {
  id             String       @id @default(cuid())
  organizationId String
  productId      String?
  variantId      String?
  locationId     String
  locationType   LocationType
  quantity       Decimal      @default(0) @db.Decimal(12, 3)
  unitId         String?
  minThreshold   Decimal      @default(0) @db.Decimal(12, 3)
  updatedAt      DateTime     @updatedAt

  organization Organization    @relation(fields: [organizationId], references: [id])
  product      Product?        @relation(fields: [productId], references: [id])
  variant      ProductVariant? @relation(fields: [variantId], references: [id])
  unit         UnitOfMeasure?  @relation(fields: [unitId], references: [id])

  // XOR variant/product validado en aplicación: MySQL 8 (error 3823) impide
  // CHECK sobre columnas con FK ON DELETE SET NULL / ON UPDATE CASCADE.
  // Ver migración 20260811050000_customer_phone_unique_inventory_check.
  @@unique([variantId, locationId, locationType])
  @@map("inventory")
}

model InventoryMovement {
  id             String       @id @default(cuid())
  organizationId String
  productId      String?
  variantId      String?
  locationId     String
  locationType   LocationType
  type           MovementType
  quantity       Decimal      @db.Decimal(12, 3)
  unitId         String?
  reason         String?
  referenceId    String?
  employeeId     String?
  userId         String?
  createdAt      DateTime     @default(now())

  organization Organization    @relation(fields: [organizationId], references: [id])
  product      Product?        @relation(fields: [productId], references: [id])
  variant      ProductVariant? @relation(fields: [variantId], references: [id])
  unit         UnitOfMeasure?  @relation(fields: [unitId], references: [id])
  employee     Employee?       @relation(fields: [employeeId], references: [id])
  user         User?           @relation(fields: [userId], references: [id])

  @@map("inventory_movements")
}

model VariantPriceHistory {
  id             String   @id @default(cuid())
  organizationId String
  variantId      String
  oldPrice       Decimal? @db.Decimal(12, 2)
  newPrice       Decimal? @db.Decimal(12, 2)
  oldCost        Decimal? @db.Decimal(12, 2)
  newCost        Decimal? @db.Decimal(12, 2)
  changedBy      String?
  createdAt      DateTime @default(now())

  organization Organization     @relation(fields: [organizationId], references: [id])
  variant      ProductVariant   @relation(fields: [variantId], references: [id])
  changedByUser User?           @relation(fields: [changedBy], references: [id])

  @@map("variant_price_history")
}

model InventoryRevision {
  id             String         @id @default(cuid())
  organizationId String
  locationId     String
  locationType   LocationType
  revisionNumber Int
  status         RevisionStatus @default(draft)
  notes          String?
  performedBy    String?
  employeeId     String?
  startedAt      DateTime?
  completedAt    DateTime?
  createdAt      DateTime       @default(now())

  organization Organization @relation(fields: [organizationId], references: [id])
  performedByUser User?     @relation("InventoryRevisionPerformedBy", fields: [performedBy], references: [id])
  employee      Employee?   @relation(fields: [employeeId], references: [id])
  items         InventoryRevisionItem[]

  @@map("inventory_revisions")
}

model InventoryRevisionItem {
  id                 String   @id @default(cuid())
  revisionId         String
  productId          String?
  variantId          String?
  expectedQuantity   Decimal? @db.Decimal(12, 3)
  countedQuantity    Decimal? @db.Decimal(12, 3)
  difference         Decimal? @db.Decimal(12, 3)
  notes              String?
  scanned            Boolean  @default(false)
  countedBy          String?
  createdAt          DateTime @default(now())

  revision       InventoryRevision @relation(fields: [revisionId], references: [id])
  product        Product?          @relation(fields: [productId], references: [id])
  variant        ProductVariant?   @relation(fields: [variantId], references: [id])
  countedByUser  User?             @relation("InventoryRevisionItemCountedBy", fields: [countedBy], references: [id])

  @@map("inventory_revision_items")
}

// ─────────────────────────────────────────────────────────────────────────────
// VENTAS
// ─────────────────────────────────────────────────────────────────────────────

model Sale {
  id                 String     @id @default(cuid())
  organizationId     String
  locationId         String
  cashSessionId      String?
  cashRegisterId     String?
  cashierId          String?
  employeeId         String?
  customerId         String?
  saleNumber         BigInt     @unique @default(autoincrement())
  locationSaleNumber BigInt?
  subtotal           Decimal    @default(0) @db.Decimal(12, 2)
  discount           Decimal    @default(0) @db.Decimal(12, 2)
  tax                Decimal    @default(0) @db.Decimal(12, 2)
  total              Decimal    @default(0) @db.Decimal(12, 2)
  pointsEarned       Decimal    @default(0) @db.Decimal(12, 2)
  pointsRedeemed     Decimal    @default(0) @db.Decimal(12, 2)
  changeGiven        Decimal    @default(0) @db.Decimal(12, 2)
  tip                Decimal    @default(0) @db.Decimal(12, 2)
  status             SaleStatus @default(completed)
  notes              String?
  createdAt          DateTime   @default(now())

  organization Organization @relation(fields: [organizationId], references: [id])
  location     Location     @relation(fields: [locationId], references: [id])
  cashSession  CashSession? @relation(fields: [cashSessionId], references: [id])
  cashRegister CashRegister? @relation(fields: [cashRegisterId], references: [id])
  cashier      User?        @relation("SaleCashier", fields: [cashierId], references: [id])
  employee     Employee?    @relation(fields: [employeeId], references: [id])
  customer     Customer?    @relation(fields: [customerId], references: [id])
  items        SaleItem[]
  payments     SalePayment[]
  discounts    SaleDiscount[]
  coupons      Coupon[]
  loyaltyTransactions LoyaltyTransaction[]
  orders       Order[]
  returns      SaleReturn[]
  commissions  EmployeeCommission[]

  @@map("sales")
}

model SaleItem {
  id                   String      @id @default(cuid())
  saleId               String
  productId            String?
  variantId            String?
  productName          String
  variantName          String?
  productType          ProductType
  quantity             Decimal     @db.Decimal(12, 3)
  unitId               String?
  unitPrice            Decimal     @db.Decimal(12, 2)
  unitCost             Decimal?    @db.Decimal(12, 2)
  totalPrice           Decimal?    @db.Decimal(12, 2)
  discount             Decimal     @default(0) @db.Decimal(12, 2)
  taxRate              Decimal     @default(0) @db.Decimal(5, 4)
  lineTotal            Decimal?    @db.Decimal(12, 2)
  bulkQuantityDisplay  String?
  notes                String?
  selectedOptions      Json?
  extraPrice           Decimal  @default(0) @db.Decimal(12, 2)

  sale     Sale           @relation(fields: [saleId], references: [id])
  product  Product?       @relation(fields: [productId], references: [id])
  variant  ProductVariant? @relation(fields: [variantId], references: [id])
  unit     UnitOfMeasure? @relation(fields: [unitId], references: [id])

  @@map("sale_items")
}

model SalePayment {
  id        String        @id @default(cuid())
  saleId    String
  method    PaymentMethod
  amount    Decimal       @db.Decimal(12, 2)
  reference String?
  createdAt DateTime      @default(now())

  sale Sale @relation(fields: [saleId], references: [id])

  @@map("sale_payments")
}

model SaleDiscount {
  id           String   @id @default(cuid())
  saleId       String
  promotionId  String?
  label        String
  amount       Decimal  @db.Decimal(12, 2)
  createdAt    DateTime @default(now())

  sale      Sale        @relation(fields: [saleId], references: [id])
  promotion Promotion?  @relation(fields: [promotionId], references: [id])

  @@map("sale_discounts")
}

// ─────────────────────────────────────────────────────────────────────────────
// PROMOCIONES
// ─────────────────────────────────────────────────────────────────────────────

model Promotion {
  id                   String       @id @default(cuid())
  organizationId       String
  name                 String
  description          String?
  descriptionFinal     String?
  imageUrl             String?
  benefit              PromoBenefit
  scope              PromoScope   @default(order)
  businessMode        String?      // null=todos, "retail", "food_service", etc.
  value                Decimal      @default(0) @db.Decimal(12, 2)
  buyQuantity          Int          @default(0)
  getQuantity          Int          @default(0)
  minAmount            Decimal      @default(0) @db.Decimal(12, 2)
  minQuantity          Decimal      @default(0) @db.Decimal(12, 3)
  startsAt             DateTime?
  endsAt               DateTime?
  weekdays             String?
  startTime            String?
  endTime              String?
  couponCode           String?
  requiresCustomer     Boolean      @default(false)
  priority             Int          @default(100)
  exclusive            Boolean      @default(false)
  maxUses              Int?
  maxUsesPerCustomer   Int?
  usesCount            Int          @default(0)
  isActive             Boolean      @default(true)
  createdBy            String?
  createdAt            DateTime     @default(now())
  updatedAt            DateTime     @updatedAt

  organization Organization      @relation(fields: [organizationId], references: [id])
  createdByUser User?            @relation("PromotionCreatedBy", fields: [createdBy], references: [id])
  targets       PromotionTarget[]
  coupons       Coupon[]
  saleDiscounts SaleDiscount[]

  @@map("promotions")
}

model PromotionTarget {
  id          String              @id @default(cuid())
  promotionId String
  kind        PromotionTargetKind
  targetId    String
  createdAt   DateTime            @default(now())

  promotion Promotion @relation(fields: [promotionId], references: [id])

  @@unique([promotionId, kind, targetId])
  @@map("promotion_targets")
}

model Coupon {
  id             String    @id @default(cuid())
  organizationId String
  promotionId    String?
  customerId     String?
  code           String
  amount         Decimal   @default(0) @db.Decimal(12, 2)
  percent        Decimal   @default(0) @db.Decimal(5, 2)
  expiresAt      DateTime?
  redeemedAt     DateTime?
  redeemedSaleId String?
  createdAt      DateTime  @default(now())

  organization Organization @relation(fields: [organizationId], references: [id])
  promotion    Promotion?   @relation(fields: [promotionId], references: [id])
  customer     Customer?    @relation(fields: [customerId], references: [id])
  redeemedSale Sale?        @relation(fields: [redeemedSaleId], references: [id])

  @@unique([organizationId, code])
  @@map("coupons")
}

// ─────────────────────────────────────────────────────────────────────────────
// LEALTAD / PUNTOS
// ─────────────────────────────────────────────────────────────────────────────

model LoyaltyTransaction {
  id             String      @id @default(cuid())
  organizationId String
  customerId     String
  saleId         String?
  kind           LoyaltyKind
  points         Decimal     @db.Decimal(12, 2)
  note           String?
  createdAt      DateTime    @default(now())

  organization Organization @relation(fields: [organizationId], references: [id])
  customer     Customer     @relation(fields: [customerId], references: [id])
  sale         Sale?        @relation(fields: [saleId], references: [id])

  @@map("loyalty_transactions")
}

// ─────────────────────────────────────────────────────────────────────────────
// PEDIDOS (PORTAL)
// ─────────────────────────────────────────────────────────────────────────────

model Order {
  id             String         @id @default(cuid())
  organizationId String
  locationId     String?
  customerId     String?
  tableId        String?        // Mesa asociada (food_service)
  orderNumber    BigInt         @unique @default(autoincrement())
  status         OrderStatus    @default(pending)
  deliveryMethod DeliveryMethod
  subtotal       Decimal        @default(0) @db.Decimal(12, 2)
  discount       Decimal        @default(0) @db.Decimal(12, 2)
  total          Decimal        @default(0) @db.Decimal(12, 2)
  notes          String?
  saleId         String?
  // FASE 13.6 — entrega a domicilio + método de pago del pedido
  address         String?
  latitude        Decimal?       @db.Decimal(10, 8)
  longitude       Decimal?       @db.Decimal(11, 8)
  paymentMethod   PaymentMethod?
  paymentReference String?
  deliveryFee     Decimal?       @default(0) @db.Decimal(12, 2)
  tip             Decimal?       @default(0) @db.Decimal(12, 2)
  // FASE — confirmación de entrega domicilio (PIN + QR)
  deliveryPin     String?        @db.VarChar(6)
  deliveryQrToken String?        @unique
  // FASE — cobro en tienda (cuando el cliente paga al recoger/recibir)
  paidAt          DateTime?
  // FASE — redención de puntos en el portal
  pointsRedeemed  Decimal?       @default(0) @db.Decimal(12, 2)
  pointsValue     Decimal?       @default(0) @db.Decimal(12, 2)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  organization Organization      @relation(fields: [organizationId], references: [id])
  location     Location?         @relation(fields: [locationId], references: [id])
  customer     Customer?         @relation(fields: [customerId], references: [id])
  table        Table?            @relation(fields: [tableId], references: [id])
  sale         Sale?             @relation(fields: [saleId], references: [id])
  items        OrderItem[]
  statusHistory OrderStatusHistory[]
  preparation  OrderPreparation?
  tableSessions TableSession[]

  @@map("orders")
}

model OrderItem {
  id                  String          @id @default(cuid())
  orderId             String
  productId           String?
  variantId           String?
  productName         String
  variantName         String?
  productType         ProductType
  quantity            Decimal         @db.Decimal(12, 3)
  unitId              String?
  unitPrice           Decimal         @db.Decimal(12, 2)
  lineTotal           Decimal?        @db.Decimal(12, 2)
  bulkQuantityDisplay String?
  comment             String?
  selectedOptions     Json?
  extraPrice          Decimal         @default(0) @db.Decimal(12, 2)
  itemStatus          OrderItemStatus @default(pending)
  createdAt           DateTime        @default(now())

  order            Order                  @relation(fields: [orderId], references: [id])
  product          Product?               @relation(fields: [productId], references: [id])
  variant          ProductVariant?        @relation(fields: [variantId], references: [id])
  unit             UnitOfMeasure?         @relation(fields: [unitId], references: [id])
  preparationItems OrderPreparationItem[]

  @@map("order_items")
}

model OrderStatusHistory {
  id         String      @id @default(cuid())
  orderId    String
  status     OrderStatus
  employeeId String?
  userId     String?
  notes      String?
  createdAt  DateTime    @default(now())

  order    Order     @relation(fields: [orderId], references: [id])
  employee Employee? @relation(fields: [employeeId], references: [id])
  user     User?     @relation(fields: [userId], references: [id])

  @@map("order_status_history")
}

model OrderPreparation {
  id             String   @id @default(cuid())
  orderId        String   @unique
  employeeId     String?
  startedAt      DateTime?
  completedAt    DateTime?
  elapsedSeconds Int?
  generalNotes   String?
  createdAt      DateTime @default(now())

  order   Order                   @relation(fields: [orderId], references: [id])
  employee Employee?              @relation(fields: [employeeId], references: [id])
  items   OrderPreparationItem[]

  @@map("order_preparation")
}

model OrderPreparationItem {
  id            String   @id @default(cuid())
  preparationId String
  orderItemId   String
  scanned       Boolean  @default(false)
  found         Boolean  @default(false)
  employeeNotes String?
  createdAt     DateTime @default(now())

  preparation OrderPreparation @relation(fields: [preparationId], references: [id])
  orderItem   OrderItem        @relation(fields: [orderItemId], references: [id])

  @@map("order_preparation_items")
}

// ─────────────────────────────────────────────────────────────────────────────
// MESAS Y KDS (food_service / hybrid)
// ─────────────────────────────────────────────────────────────────────────────

model Table {
  id             String      @id @default(cuid())
  organizationId String
  locationId     String?
  number         Int
  name           String?
  capacity       Int         @default(4)
  status         TableStatus @default(free)
  qrToken        String?     @unique
  posX           Int?        // Posición en el mapa (grid)
  posY           Int?        // Posición en el mapa (grid)
  isActive       Boolean     @default(true)
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  organization Organization        @relation(fields: [organizationId], references: [id])
  location     Location?           @relation(fields: [locationId], references: [id])
  sessions     TableSession[]
  orders       Order[]

  @@unique([organizationId, number])
  @@map("tables")
}

model TableSession {
  id         String    @id @default(cuid())
  tableId    String
  orderId    String?
  startedAt  DateTime  @default(now())
  endedAt    DateTime?
  notes      String?

  table  Table   @relation(fields: [tableId], references: [id])
  order  Order?  @relation(fields: [orderId], references: [id])

  @@map("table_sessions")
}

// ─────────────────────────────────────────────────────────────────────────────
// ADMINISTRACIÓN
// ─────────────────────────────────────────────────────────────────────────────

model Permission {
  key    String @id
  module String
  action String
  label  String

  rolePermissions RolePermission[]

  @@map("permissions")
}

model Role {
  id             String   @id @default(cuid())
  organizationId String?
  name           String
  description    String?
  isSystem       Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization?  @relation(fields: [organizationId], references: [id])
  permissions  RolePermission[]
  memberships  Membership[]

  @@map("roles")
}

model RolePermission {
  id             String  @id @default(cuid())
  organizationId String?
  roleId         String
  permissionKey  String
  allowed        Boolean @default(true)
  createdAt      DateTime @default(now())

  organization Organization? @relation(fields: [organizationId], references: [id])
  role         Role         @relation(fields: [roleId], references: [id])
  permission   Permission   @relation(fields: [permissionKey], references: [key])

  @@unique([organizationId, roleId, permissionKey])
  @@map("role_permissions")
}

model UserInvitation {
  id             String   @id @default(cuid())
  organizationId String
  email          String
  role           OrgRole   @default(cashier)
  locationId     String?
  status         String   @default("pending")
  invitedBy      String?
  acceptedAt     DateTime?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id])
  invitedByUser User?       @relation("UserInvitationInvitedBy", fields: [invitedBy], references: [id])

  @@map("user_invitations")
}

model Menu {
  id            String   @id @default(cuid())
  parentId      String?
  type          String   @default("item") @db.VarChar(20)
  label         String   @db.VarChar(100)
  icon          String?  @db.VarChar(50)
  href          String?  @db.VarChar(255)
  badge         String?  @db.VarChar(50)
  badgeVariant  String?  @db.VarChar(20)
  permissionKey String?  @db.VarChar(50)
  sortOrder     Int      @default(0)
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  parent   Menu?  @relation("MenuHierarchy", fields: [parentId], references: [id], onDelete: SetNull)
  children Menu[] @relation("MenuHierarchy")

  @@index([parentId])
  @@map("menus")
}

model Notification {
  id             String   @id @default(cuid())
  organizationId String
  locationId     String?
  userId         String?
  employeeId     String?
  kind           String
  title          String
  body           String?
  severity       String   @default("info")
  link           String?
  metadata       Json?
  readAt         DateTime?
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id])
  location     Location?    @relation(fields: [locationId], references: [id])
  user         User?        @relation(fields: [userId], references: [id])
  employee     Employee?    @relation(fields: [employeeId], references: [id])

  @@map("notifications")
}

model Publication {
  id             String          @id @default(cuid())
  organizationId String
  title          String
  content        String?
  imageUrl       String?
  type           PublicationType
  isActive       Boolean         @default(true)
  businessMode   String?         // null=todos, "retail", "food_service", etc.
  publishedAt    DateTime?
  startsAt       DateTime?
  endsAt         DateTime?
  metadata       Json?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id])

  @@map("publications")
}

model SaleReturn {
  id              String       @id @default(cuid())
  organizationId  String
  saleId          String
  locationId      String
  cashSessionId   String?
  employeeId      String?
  userId          String?
  returnType      ReturnType
  status          ReturnStatus @default(pending)
  reason          String?
  subtotal        Decimal      @default(0) @db.Decimal(12, 2)
  tax             Decimal      @default(0) @db.Decimal(12, 2)
  total           Decimal      @default(0) @db.Decimal(12, 2)
  notes           String?
  exchangeSaleId  String?
  couponCode      String?
  couponAmount    Decimal?     @db.Decimal(12, 2)
  couponExpiresAt DateTime?
  pointsAwarded   Decimal?     @db.Decimal(12, 2)
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  organization Organization    @relation(fields: [organizationId], references: [id])
  sale         Sale            @relation(fields: [saleId], references: [id])
  cashSession  CashSession?    @relation(fields: [cashSessionId], references: [id])
  employee     Employee?       @relation(fields: [employeeId], references: [id])
  user         User?           @relation(fields: [userId], references: [id])
  items        SaleReturnItem[]

  @@index([organizationId])
  @@index([saleId])
  @@map("sale_returns")
}

model SaleReturnItem {
  id            String  @id @default(cuid())
  returnId      String
  saleItemId    String
  productId     String?
  variantId     String?
  productName   String
  variantName   String?
  quantity      Decimal @db.Decimal(12, 3)
  unitPrice     Decimal @db.Decimal(12, 2)
  lineTotal     Decimal @db.Decimal(12, 2)
  reason        String?
  restockable   Boolean @default(true)

  return SaleReturn @relation(fields: [returnId], references: [id])

  @@index([returnId])
  @@map("sale_return_items")
}


// ─────────────────────────────────────────────────────────────────────────────
// WEB PUSH NOTIFICATIONS
// ─────────────────────────────────────────────────────────────────────────────

model PushSubscription {
  id             String   @id @default(cuid())
  organizationId String
  userId         String
  endpoint       String   @db.VarChar(512)
  p256dh         String   @db.VarChar(255)
  auth           String   @db.VarChar(255)
  userAgent      String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id])
  user         User         @relation(fields: [userId], references: [id])

  @@unique([userId, endpoint])
  @@map("push_subscriptions")
}

// ══════════════════════════════════════════════════════════════════════════
// BUSINESS INTELLIGENCE — Agregados y analítica
// ══════════════════════════════════════════════════════════════════════════

model DailySalesSummary {
  id             String   @id @default(cuid())
  organizationId String
  locationId     String
  date           DateTime @db.Date

  salesCount       Int     @default(0)
  grossSales       Decimal @default(0) @db.Decimal(14, 2)
  returnsTotal     Decimal @default(0) @db.Decimal(14, 2)
  netSales         Decimal @default(0) @db.Decimal(14, 2)
  discountTotal    Decimal @default(0) @db.Decimal(14, 2)
  taxTotal         Decimal @default(0) @db.Decimal(14, 2)
  tipTotal         Decimal @default(0) @db.Decimal(14, 2)

  posSales         Decimal @default(0) @db.Decimal(14, 2)
  portalSales      Decimal @default(0) @db.Decimal(14, 2)
  pickupSales      Decimal @default(0) @db.Decimal(14, 2)
  deliverySales    Decimal @default(0) @db.Decimal(14, 2)

  cashPayments     Decimal @default(0) @db.Decimal(14, 2)
  cardPayments     Decimal @default(0) @db.Decimal(14, 2)
  creditPayments   Decimal @default(0) @db.Decimal(14, 2)
  onlinePayments   Decimal @default(0) @db.Decimal(14, 2)

  ticketAverage    Decimal @default(0) @db.Decimal(14, 2)
  totalItems       Int     @default(0)
  upt              Decimal @default(0) @db.Decimal(8, 2)

  pointsEarned     Int     @default(0)
  pointsRedeemed   Int     @default(0)
  pointsRedemptionValue Decimal @default(0) @db.Decimal(14, 2)

  uniqueCustomers  Int     @default(0)
  newCustomers     Int     @default(0)

  createdAt        DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id])
  location     Location     @relation(fields: [locationId], references: [id])

  @@unique([organizationId, locationId, date])
  @@index([organizationId, date])
  @@map("daily_sales_summaries")
}

model HourlySalesSnapshot {
  id             String   @id @default(cuid())
  organizationId String
  locationId     String
  date           DateTime @db.Date
  hour           Int

  salesCount Int     @default(0)
  netSales   Decimal @default(0) @db.Decimal(14, 2)
  totalItems Int     @default(0)

  organization Organization @relation(fields: [organizationId], references: [id])
  location     Location     @relation(fields: [locationId], references: [id])

  @@unique([organizationId, locationId, date, hour])
  @@map("hourly_sales_snapshots")
}

model ProductPair {
  id             String   @id @default(cuid())
  organizationId String
  productIdA     String
  productIdB     String
  coOccurrences  Int      @default(0)
  lastSeenAt     DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id])
  productA     Product      @relation("PairA", fields: [productIdA], references: [id])
  productB     Product      @relation("PairB", fields: [productIdB], references: [id])

  @@unique([organizationId, productIdA, productIdB])
  @@index([organizationId, coOccurrences(sort: Desc)])
  @@map("product_pairs")
}

model InventorySnapshot {
  id             String   @id @default(cuid())
  organizationId String
  locationId     String
  productId      String
  variantId      String?
  date           DateTime @db.Date

  quantityAtCost Decimal @default(0) @db.Decimal(14, 4)
  valueAtCost    Decimal @default(0) @db.Decimal(14, 2)
  valueAtRetail  Decimal @default(0) @db.Decimal(14, 2)

  organization Organization @relation(fields: [organizationId], references: [id])
  location     Location     @relation(fields: [locationId], references: [id])
  product      Product      @relation(fields: [productId], references: [id])

  @@unique([organizationId, locationId, productId, variantId, date])
  @@index([organizationId, date])
  @@map("inventory_snapshots")
}

enum TransferStatus {
  pending
  in_transit
  received
  cancelled
}

model Transfer {
  id             String         @id @default(cuid())
  organizationId String
  fromLocationId String
  toLocationId   String
  status         TransferStatus @default(pending)
  notes          String?
  createdAt      DateTime       @default(now())
  completedAt    DateTime?

  organization Organization @relation(fields: [organizationId], references: [id])
  fromLocation Location     @relation("TransferFrom", fields: [fromLocationId], references: [id])
  toLocation   Location     @relation("TransferTo", fields: [toLocationId], references: [id])
  items        TransferItem[]

  @@index([organizationId, status])
  @@map("transfers")
}

model TransferItem {
  id          String  @id @default(cuid())
  transferId  String
  productId   String
  variantId   String?
  quantity    Decimal @db.Decimal(14, 4)
  receivedQty Decimal? @db.Decimal(14, 4)

  transfer Transfer @relation(fields: [transferId], references: [id])
  product  Product  @relation(fields: [productId], references: [id])

  @@map("transfer_items")
}

enum CommissionStatus {
  pending
  approved
  paid
}

model EmployeeCommission {
  id             String           @id @default(cuid())
  organizationId String
  employeeId     String
  saleId         String?
  period         DateTime         @db.Date
  baseSalary     Decimal          @default(0) @db.Decimal(14, 2)
  commissionRate Decimal          @default(0) @db.Decimal(5, 2)
  commissionAmt  Decimal          @default(0) @db.Decimal(14, 2)
  salesTotal     Decimal          @default(0) @db.Decimal(14, 2)
  status         CommissionStatus @default(pending)
  createdAt      DateTime         @default(now())

  organization Organization @relation(fields: [organizationId], references: [id])
  employee     Employee     @relation(fields: [employeeId], references: [id])
  sale         Sale?        @relation(fields: [saleId], references: [id])

  @@unique([organizationId, employeeId, saleId])
  @@index([organizationId, period])
  @@map("employee_commissions")
}

enum CustomerSegmentType {
  vip
  regular
  at_risk
  dormant
  new
  coupon_hunter
}

model CustomerSegment {
  id             String              @id @default(cuid())
  organizationId String
  customerId     String
  segment        CustomerSegmentType
  score          Int                 @default(0)
  assignedAt     DateTime            @default(now())
  expiresAt      DateTime?

  organization Organization @relation(fields: [organizationId], references: [id])
  customer     Customer     @relation(fields: [customerId], references: [id])

  @@unique([organizationId, customerId, segment])
  @@map("customer_segments")
}
