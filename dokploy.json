{
  "$schema": "https://dokploy.com/docs/configuration/dokploy-json",
  "name": "multi-pos",
  "description": "Sistema Multi-POS — Next.js full-stack + Prisma/MySQL",
  "compose": {
    "services": {
      "app": {
        "build": {
          "context": ".",
          "dockerfile": "Dockerfile",
          "args": {
            "NEXT_PUBLIC_APP_URL": "${NEXT_PUBLIC_APP_URL}"
          }
        },
        "ports": ["3000:3000"],
        "volumes": [
          "uploads:/app/public/uploads"
        ],
        "environment": {
          "NODE_ENV": "production",
          "UPLOADS_DIR": "/app/public/uploads",
          "UPLOADS_PROJECT": "${UPLOADS_PROJECT:-multi-pos}",
          "SEED_DEMO": "${SEED_DEMO:-true}"
        }
      }
    },
    "volumes": {
      "uploads": {
        "driver": "local"
      }
    }
  }
}
