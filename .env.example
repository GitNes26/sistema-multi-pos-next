# FASE 0.13 — Variables de entorno (copia este archivo a .env.local)

# Base de datos MySQL
DATABASE_URL="mysql://root:password@localhost:3306/multi_pos"
# Opt-in de datos demo (organizaciones de ejemplo). Solo desarrollo: se ignora
# en producción (NODE_ENV=production) y sin "true" el seeder crea únicamente la
# base de producción (roles, permisos, menús). No definir en producción.
SEED_DEMO="true"
# NextAuth v4
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="genera-con: openssl rand -base64 32"

# WhatsApp de contacto (landing page, botón de registro)
NEXT_PUBLIC_WHATSAPP_NUMBER="5215500000000"
NEXT_PUBLIC_WHATSAPP_MESSAGE="Me%20interesa%20tu%20Multi-POS%20y%20quiero%20saber%20m%C3%A1s"

# Google Maps (opcional — habilita autocomplete de direcciones)
# Obtén tu API key en: https://console.cloud.google.com/apis/credentials
# Habilita: Maps JavaScript API + Places API
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=""

# WhatsApp/SMS al invitado cuando el anfitrión confirma su reservación sin
# cuenta (Twilio REST). Sin credenciales el aviso se omite con un log.
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
# Remitente WhatsApp (E.164, acepta prefijo whatsapp:) y remitente SMS de fallback
TWILIO_WHATSAPP_FROM=""
TWILIO_SMS_FROM=""
# Lada por defecto para teléfonos locales de 10 dígitos (default: 52)
# MESSAGING_DEFAULT_COUNTRY_CODE="52"
